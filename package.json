{
  "name": "costgrid",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --build --force",
    "gateway": "node --env-file-if-exists=.env --import tsx packages/gateway/src/main.ts",
    "gateway:dev": "node --env-file-if-exists=.env --import tsx --watch packages/gateway/src/main.ts",
    "desktop": "COSTGRID_DESKTOP=true node --import tsx packages/gateway/src/main.ts",
    "desktop:init": "node --import tsx packages/gateway/src/desktop-init.ts",
    "verify-pricing": "npm run build --silent && node scripts/verify-pricing.mjs",
    "sync-design-tokens": "node scripts/sync-design-tokens.mjs",
    "check-design-tokens": "node scripts/sync-design-tokens.mjs --check",
    "emit-postgres-schema": "npm run build --silent && node scripts/emit-postgres-schema.mjs",
    "bench": "node scripts/bench-latency.mjs",
    "bench:live": "node --env-file=.env scripts/bench-latency.mjs --live"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.14.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^4.1.11"
  }
}
