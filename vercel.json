{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "echo 'static site - nothing to build'",
  "installCommand": "mkdir -p /tmp/cg-fn && npm init -y --prefix /tmp/cg-fn >/dev/null && npm install --prefix /tmp/cg-fn --omit=dev --ignore-scripts --no-audit --no-fund stripe@23.2.0 @supabase/supabase-js@2.117.1 && rm -rf node_modules && mkdir -p node_modules && cp -a /tmp/cg-fn/node_modules/. node_modules/",
  "outputDirectory": ".",
  "functions": {
    "api/stripe/*.mjs": {
      "maxDuration": 30
    }
  },
  "redirects": [
    { "source": "/", "has": [{ "type": "host", "value": "costgrid.dev" }], "destination": "https://costgrid.org/", "permanent": true },
    { "source": "/", "has": [{ "type": "host", "value": "www.costgrid.dev" }], "destination": "https://costgrid.org/", "permanent": true },
    { "source": "/:path*", "has": [{ "type": "host", "value": "costgrid.dev" }], "destination": "https://costgrid.org/:path*", "permanent": true },
    { "source": "/:path*", "has": [{ "type": "host", "value": "www.costgrid.dev" }], "destination": "https://costgrid.org/:path*", "permanent": true },
    { "source": "/:path*", "has": [{ "type": "host", "value": "www.costgrid.org" }], "destination": "https://costgrid.org/:path*", "permanent": true },
    { "source": "/thesis.html", "destination": "/research.html", "permanent": true },
    { "source": "/thesis", "destination": "/research.html", "permanent": true },
    { "source": "/dashboard.html", "destination": "/research.html", "permanent": true },
    { "source": "/dashboard", "destination": "/research.html", "permanent": true },
    { "source": "/site/stripe/:path*", "destination": "/", "permanent": false },
    { "source": "/package.json", "destination": "/", "permanent": false },
    { "source": "/package-lock.json", "destination": "/", "permanent": false }
  ],
  "headers": [
    {
      "source": "/demo/api/(.*)",
      "headers": [
        {
          "key": "cache-control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "x-content-type-options",
          "value": "nosniff"
        },
        {
          "key": "referrer-policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "strict-transport-security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "x-frame-options",
          "value": "DENY"
        },
        {
          "key": "permissions-policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()"
        },
        {
          "key": "cross-origin-opener-policy",
          "value": "same-origin"
        },
        {
          "key": "content-security-policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' https://wuxrdpsuykzsfdfpbnmi.supabase.co; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        }
      ]
    }
  ]
}
