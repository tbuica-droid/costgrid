# Copy to .env and fill in. .env is gitignored — never commit a real key.

# Your Anthropic API key. The gateway holds this so calling services never do.
ANTHROPIC_API_KEY=sk-ant-...

# Where CostGrid stores metering data.
COSTGRID_DB=./costgrid.db

COSTGRID_PORT=8787
COSTGRID_HOST=127.0.0.1

# Attribute unauthenticated calls to the "local" tenant instead of rejecting
# them. Convenient while you are the only caller; must be false once anyone
# else can reach the gateway.
COSTGRID_ALLOW_ANONYMOUS=true

# --- Hosted mode -------------------------------------------------------
# Leave false to run CostGrid for your own organisation using the keys above.
# Set true to run it as a service others sign up for: they bring their own
# provider keys, which are encrypted with COSTGRID_MASTER_KEY. See
# docs/HOSTING.md before enabling — you would be holding other companies'
# credentials.
COSTGRID_HOSTED=false

# Required when COSTGRID_HOSTED=true. Generate with: openssl rand -base64 48
# Losing this makes every stored tenant credential unrecoverable.
# COSTGRID_MASTER_KEY=

# Session cookies get the Secure flag. Defaults to true in hosted mode; you
# must terminate TLS in front of the gateway.
# COSTGRID_SECURE_COOKIES=true

COSTGRID_LOG_LEVEL=info

# --- The analyst (optional) -------------------------------------------------
# Lets you ask about your own spending in plain English:
#   costgrid ask "why did spend go up last week"
#
# Off unless you set a key. Your figures go to whichever model you point it at,
# so use your own account: your data goes to a vendor you already trust.
# Run `costgrid ask --show-data` first. It prints exactly what would be sent
# and sends nothing.
#
# COSTGRID_ANALYST_WIRE=openai            # openai (default) or anthropic
# COSTGRID_ANALYST_KEY=
# COSTGRID_ANALYST_MODEL=
# COSTGRID_ANALYST_BASE_URL=              # e.g. https://api.x.ai for Grok
