{
  "name": "@costgrid/desktop",
  "version": "3.0.1",
  "description": "CostGrid for one computer: the gateway and its console in a window.",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac --publish never",
    "dist:dir": "electron-builder --dir",
    "release": "electron-builder --mac --publish always"
  },
  "dependencies": {
    "@costgrid/gateway": "3.0.1",
    "@napi-rs/keyring": "2.1.2"
  },
  "devDependencies": {
    "electron": "44.9.3",
    "electron-builder": "^26.18.0"
  }
}
